def menu_update(avail):
    clear()
    header()
    print(f"  {CYAN}METTRE À JOUR{RESET}\n")
    print(f"  {CYAN}Choisir le gestionnaire :{RESET}")
    for i, m in enumerate(avail, 1):
        print(f"  {CYAN}{i}{RESET}  {m}")
    print(f"  {CYAN}a{RESET}  Tous")
    print(f"  {CYAN}0{RESET}  Annuler\n")

    choice = input(f"  {BOLD}>{RESET} ").strip()

    if choice == "0":
        return
    elif choice == "a":
        for mgr in avail:
            print(f"\n  {YELLOW}→ Mise à jour {mgr}...{RESET}")
            run(f"sudo {MANAGERS[mgr]['update']}")
    elif choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(avail):
            mgr = avail[idx]
            run(f"sudo {MANAGERS[mgr]['update']}")

    input(f"\n  {GRAY}Appuyer sur Entrée...{RESET}")


def menu_modules(avail):
    while True:
        clear()
        header()
        print(f"  {CYAN}MODULES STINUXCLI{RESET}\n")
        keys = list(MODULES.keys())
        for i, key in enumerate(keys, 1):
            mod = MODULES[key]
            print(f"  {CYAN}{i}{RESET}  {key:<12} {GRAY}{mod['desc']}{RESET}")
        print(f"\n  {CYAN}0{RESET}  Retour\n")

        choice = input(f"  {BOLD}>{RESET} ").strip()
        if choice == "0":
            return
        if not choice.isdigit():
            continue

        idx = int(choice) - 1
        if 0 <= idx < len(keys):
            key = keys[idx]
            mod = MODULES[key]
            clear()
            header()
            print(f"  {CYAN}MODULE : {key.upper()}{RESET}")
            print(f"  {GRAY}{mod['desc']}{RESET}\n")

            mgr = None
            for m in avail:
                if m in mod["packages"]:
                    mgr = m
                    break

            if not mgr:
                print(f"  {RED}Aucun gestionnaire compatible disponible.{RESET}")
            else:
                pkgs = " ".join(mod["packages"][mgr])
                print(f"  Gestionnaire : {GREEN}{mgr}{RESET}")
                print(f"  Paquets      : {pkgs}\n")
                confirm = input(f"  Installer ? (o/n) : ").strip().lower()
                if confirm == "o":
                    run(f"sudo {MANAGERS[mgr]['install']} {pkgs}")

            input(f"\n  {GRAY}Appuyer sur Entrée...{RESET}")


def menu_managers(avail):
    clear()
    header()
    print(f"  {CYAN}GESTIONNAIRES DISPONIBLES{RESET}\n")
    all_mgrs = list(MANAGERS.keys())
    for mgr in all_mgrs:
        status = f"{GREEN}✓ disponible{RESET}" if mgr in avail else f"{GRAY}✗ non installé{RESET}"
        print(f"  {mgr:<12} {status}")
    print()
    input(f"  {GRAY}Appuyer sur Entrée...{RESET}")


if __name__ == "__main__":
    menu_main()
